framework:
    session:
        handler_id: session.handler.native_file
        save_path: "%kernel.project_dir%/var/sessions/%kernel.environment%"
    secret: "%env(APP_SECRET)%"
    session:
        handler_id: null
        cookie_secure: false
        cookie_samesite: lax
        cookie_httponly: true
    assets: null
    error_handler:
        log: true
        throw: true
    csrf_protection:
        enabled: true
