{
    "product": {
        "magento_to_pimcore": {
            "entity_id": "magentoId",
            "sku": "sku",
            "name": "title",
            "description": "description",
            "short_description": "shortDescription",
            "status": {
                "field": "status",
                "mapping": {
                    "1": "active",
                    "2": "disabled"
                }
            },
            "media_gallery": {
                "field": "images",
                "type": "asset_gallery"
            },
            "categories": {
                "field": "categories",
                "type": "object_relation",
                "class": "Category",
                "lookup": "magentoId"
            }
        }
    },
    "category": {
        "magento_to_pimcore": {
            "entity_id": "magentoId",
            "name": "name",
            "description": "description",
            "parent_id": {
                "field": "parent",
                "type": "object_relation",
                "class": "Category",
                "lookup": "magentoId"
            },
            "position": "sortOrder",
            "image": {
                "field": "image",
                "type": "asset"
            }
        }
    }
}