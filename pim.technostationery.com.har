          "content": {
            "size": 5097,
            "mimeType": "text/css",
            "text": ".plugin_pmicon {\n    background: url(/bundles/pimcoreadmin/img/flat-color-icons/cable_release.svg) center center no-repeat !important;\n}\n\n.plugin_pmicon_header:before {\n    position: absolute;\n    width: 16px;\n    height: 16px;\n    bottom: 0px;\n    right: 0px;\n    content: \"\";\n    background: url(/bundles/pimcoreadmin/img/flat-color-icons/cable_release.svg) center center no-repeat !important;\n}\n\n.pimcore_version_6 .plugin_pmicon_header:before {\n    width: 24px;\n    height: 24px;\n}\n\n.pm_icon_cli {\n    background: url(/bundles/pimcoreadmin/img/flat-color-icons/go.svg) center center no-repeat !important;\n}\n.process-manager-notification-progress-bar {\n  /*  height:30px;*/\n}\n.plugin-process-manager-item-status-finished {\n    color: #006402;\n    font-weight: bold;\n}\n\n.plugin-process-manager-item-status-failed {\n    color: darkred;\n    font-weight: bold;\n}\n\n.process-manager-notification-progress-bar.finished,\n.process-manager-notification-progress-bar.finished .x-progress-bar {\n    background-color: #9ACD32;\n}\n.process-manager-notification-progress-bar.finished_with_errors ,\n.process-manager-notification-progress-bar.finished_with_errors .x-progress-bar ,\n.process-manager-notification-progress-bar.failed,\n.process-manager-notification-progress-bar.failed .x-progress-bar\n{\n    background-color: #FF6347;\n}\n\n#processmanager_active_processes .process-manager-notification-progress-bar.failed .x-progress-text-back,\n#processmanager_active_processes .process-manager-notification-progress-bar.finished_with_errors .x-progress-text-back,\n#processmanager_active_processes .process-manager-notification-progress-bar.finished .x-progress-text-back\n{\n    color:#fff;\n}\n.plugin-process-manager-save-button{\n    background: url(\"/bundles/pimcoreadmin/img/flat-color-icons/ok.svg\") no-repeat scroll left center transparent !important;\n}\n.plugin-process-manager-execute-button{\n    background: url(\"/bundles/pimcoreadmin/img/flat-color-icons/go.svg\") no-repeat scroll left center transparent !important;\n}\n\n.process_manager_icon_download {\n    text-decoration: none;\n    width: 27px;\n    border-radius: 3px;\n    height: 21px;\n    display: inline-block;\n    vertical-align: top;\n}\n\n.process_manager_action_js_event {\n    margin-right: 5px;\n    text-align: center;\n}\n.process_manager_action_js_event img {\n\n}\n\n    /*\n    .process_manager_icon_action_overlay_go {\n        position: absolute;\n        width: 14px;\n        height: 14px;\n        bottom: 0px;\n        right: 0px;\n        content: \"\";\n        background: url(/bundles/pimcoreadmin/img/flat-color-icons/overlay-go.svg) center center no-repeat !important;\n    }*/\n\n.process_manager_icon_action_open {\n    position: relative;\n    text-decoration: none;\n    width: 22px;\n    border-radius: 3px;\n    height: 21px;\n    display: inline-block;\n}\n\n.process_manager_icon_action_open.document {\n    background-image: url(\"/bundles/pimcoreadmin/img/flat-color-icons/document.svg\");\n}\n.process_manager_icon_action_open.object {\n    background-image: url(\"/bundles/pimcoreadmin/img/flat-color-icons/object.svg\");\n}\n.process_manager_icon_action_open.asset {\n    background-image: url(\"/bundles/pimcoreadmin/img/flat-color-icons/asset.svg\");\n}\n.process-manager-callback-settings-table {\n    border : 1px solid #ECECEC;\n    border-collapse: collapse;\n}\n.process-manager-callback-settings-table th, .process-manager-callback-settings-table td{\n    border : 1px solid #ECECEC;\n    padding: 2px;\n    font-size: 0.9em;\n}\n.process-manager-callback-settings-tabl th {\n    text-align: left;\n}\n.process-manager-link a {\n    color: #739BC8;\n}\n\n.process-manager-hide-icon {\n    display: none;\n}\n\n/* dark background under tabs */\n/* Very specific selector to only target main tab-bar in the window */\n#pimcore_plugin_pm_panel-bodyWrap > .x-tab-bar > .x-tab-bar-body {\n    background-color: #3c3f41;\n}\n\n.pm_tooltip_icon {\n    position: relative;\n    left:3px;\n    top:3px;\n}\n.pm_number_select .x-form-trigger-wrap-default{\n    height: auto;\n    vertical-align: top;\n}\n\n.plugin_pm_property_selector_panel_source {\n    border-top: 1px solid #d0d0d0;\n    border-right: 1px solid #d0d0d0;\n}\n.plugin_pm_property_selector_panel_target {\n    border-top: 1px solid #d0d0d0;\n}\n.plugin_pm_property_selector_panel {\n    margin-bottom: 10px;\n}\n\n#processmanager_active_processes-body {\n    /*overflow-y: scroll;*/\n}\n\n.process-manager-active-processes-header-text {\n    margin-bottom: 2px;\n    display: block;\n}\n.process-manager-active-processes-header-text .x-form-display-field {\n    min-height: auto;\n}\n.pm-hide {\n    background-color: #ffae00;\n}\n\na.process-manager-details-link {\n    color: #404040 !important;\n}\n.x-tool-process-manager-unpublish-all {\n    background-image: url(/bundles/pimcoreadmin/img/flat-color-icons/approve.svg) !important;\n    background-size: contain;\n    background-color: #3c3f41;\n}\n\n.active_processes_finished_icon {\n    width: 15px;\n    height: 15px;\n    position: relative;\n    top:4px;\n}\n\n.process-manager-action-icon-tbar {\n    height: 18px;\n    position: relative;\n    top: 4px;\n}\n\n#pimcore_plugin_pm_panel {\n    background: none !important;\n}\n"
          },
