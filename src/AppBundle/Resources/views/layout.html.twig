<!DOCTYPE html>
<html>
    <head>
        <title>{% block title %}Akeneo PIM{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="shortcut icon" href="{{ asset('favicon.ico') }}" />
        
        <link rel="stylesheet" href="{{ asset('css/pim.css', 'frontend') }}"/>
        
        {% block head_style %}
            {{ parent() }}
        {% endblock %}
        
        <!-- Load jQuery before other JavaScript dependencies -->
        <script src="https://code.jquery.com/jquery-3.6.0.min.js" 
                integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4=" 
                crossorigin="anonymous">
        </script>
        
        <!-- Load other external JavaScript dependencies -->
        {{ external_javascript_dependencies() }}
        
        <!-- Load RequireJS with path mappings -->
        <script type="text/javascript" src="{{ asset('dist/require.min.js', 'frontend') }}"></script>
        <script type="text/javascript" src="{{ asset('js/require-paths.js', 'frontend') }}"></script>
        
        <!-- Load Akeneo specific JavaScript files in correct order -->
        <script type="text/javascript" src="{{ asset('dist/vendor.min.js', 'frontend') }}"></script>
        <script type="text/javascript" src="{{ asset('dist/main.min.js', 'frontend') }}"></script>
        
        {% block head_javascript %}
        {% endblock %}
    </head>
    <body class="{% block bodyClass %}{% endblock %}">
        <div id="page">
            {% block page %}
                <div id="main">
                    {% block content %}
                    {% endblock %}
                </div>
            {% endblock %}
        </div>
        
        {% block javascripts %}
        {% endblock %}
    </body>
</html>