<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Techno Stationery - Product Information Management</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #333;
        }
        .container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            padding: 60px 80px;
            max-width: 800px;
            text-align: center;
        }
        h1 {
            color: #667eea;
            font-size: 3em;
            margin-bottom: 20px;
            font-weight: 700;
        }
        .subtitle {
            color: #666;
            font-size: 1.3em;
            margin-bottom: 40px;
        }
        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
            margin: 40px 0;
        }
        .stat-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px 20px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
        }
        .stat-number {
            font-size: 3em;
            font-weight: bold;
            margin-bottom: 10px;
        }
        .stat-label {
            font-size: 1.1em;
            opacity: 0.9;
        }
        .btn {
            display: inline-block;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 18px 50px;
            text-decoration: none;
            border-radius: 50px;
            font-size: 1.2em;
            font-weight: 600;
            margin: 20px 10px;
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.4);
            transition: transform 0.3s, box-shadow 0.3s;
        }
        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(102, 126, 234, 0.6);
        }
        .features {
            margin-top: 50px;
            text-align: left;
        }
        .feature {
            background: #f8f9ff;
            padding: 20px;
            margin: 15px 0;
            border-radius: 10px;
            border-left: 4px solid #667eea;
        }
        .feature-title {
            color: #667eea;
            font-weight: 600;
            font-size: 1.2em;
            margin-bottom: 8px;
        }
        .status-badge {
            display: inline-block;
            background: #10b981;
            color: white;
            padding: 8px 20px;
            border-radius: 20px;
            font-weight: 600;
            margin: 20px 0;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🚀 Techno Stationery</h1>
        <p class="subtitle">Product Information Management System</p>
        <span class="status-badge">✓ System Online</span>
        
        <div class="stats">
            <div class="stat-card">
                <div class="stat-number">8.4K+</div>
                <div class="stat-label">Products</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">100+</div>
                <div class="stat-label">Categories</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">50+</div>
                <div class="stat-label">Brands</div>
            </div>
        </div>
        
        <a href="/admin/login" class="btn">🔐 Admin Login</a>
        <a href="/admin" class="btn">📊 Dashboard</a>
        
        <div class="features">
            <div class="feature">
                <div class="feature-title">✓ Product Management</div>
                <div>Manage 8,419 products with complete attributes, descriptions, and pricing</div>
            </div>
            <div class="feature">
                <div class="feature-title">✓ Category Organization</div>
                <div>Hierarchical category structure for efficient product organization</div>
            </div>
            <div class="feature">
                <div class="feature-title">✓ Brand Management</div>
                <div>Centralized brand information and product associations</div>
            </div>
            <div class="feature">
                <div class="feature-title">✓ Magento Integration</div>
                <div>DataHub GraphQL API ready for Magento 2.4.6 synchronization</div>
            </div>
        </div>
    </div>
</body>
</html>
