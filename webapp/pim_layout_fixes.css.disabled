/* ==========================================================================
   PIM UI Layout & Sidebar Fixes - Techno Stationery
   Ensures the sidebar, main content, and navigation render correctly.
   Acts as fallback for styled-components runtime CSS injection.
   ========================================================================== */

/* --- Base layout: ensure full-height flexbox --- */
html, body {
  height: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
  overflow: hidden !important;
}

.app {
  display: flex !important;
  flex-direction: row !important;
  height: 100vh !important;
  width: 100vw !important;
  overflow: hidden !important;
}

/* --- Sidebar / Main Menu (styled-components rendered) --- */
.app > [class*="sc-"] {
  flex-shrink: 0;
}

/* AknHeader sidebar fallback */
.AknHeader {
  display: flex !important;
  height: 100% !important;
  flex-direction: row !important;
}

.AknHeader-menu {
  display: flex !important;
  width: 80px !important;
  min-width: 80px !important;
  flex-basis: 80px !important;
  flex-shrink: 0 !important;
  flex-direction: column !important;
  justify-content: space-between !important;
  height: 100vh !important;
  border-right: 1px solid #ccd1d8 !important;
  z-index: 803 !important;
  background: white !important;
  overflow-y: auto !important;
  overflow-x: hidden !important;
}

/* --- Main content area --- */
.AknDefault-page {
  display: flex !important;
  width: 100% !important;
  height: 100vh !important;
  overflow: hidden !important;
}

.AknDefault-container {
  flex-grow: 1 !important;
  width: 1px !important;
  overflow: hidden !important;
}

.AknDefault-contentWithColumn {
  display: flex !important;
  height: 100% !important;
  overflow: hidden !important;
}

.AknDefault-contentWithBottom {
  flex-grow: 1 !important;
  display: flex !important;
  flex-direction: column !important;
  height: 100% !important;
  width: 100% !important;
  overflow: hidden !important;
}

.AknDefault-mainContent {
  padding: 0 40px 40px 40px !important;
  overflow-x: auto !important;
  overflow-y: auto !important;
  flex-grow: 1 !important;
  position: relative !important;
  height: 100% !important;
}

/* --- AknColumn (left panel / filter sidebar) --- */
.AknColumn {
  display: flex !important;
  flex-direction: column !important;
  width: 280px !important;
  min-width: 280px !important;
  flex-shrink: 0 !important;
  height: 100% !important;
  border-right: 1px solid #D9DDE2 !important;
  background: white !important;
  z-index: 2 !important;
  overflow-y: auto !important;
}

.AknColumn:empty {
  display: none !important;
}

.AknColumn--collapsed {
  width: 0 !important;
  min-width: 0 !important;
  overflow: hidden !important;
}

.AknColumn-inner {
  padding: 20px !important;
  flex-grow: 1 !important;
  overflow-y: auto !important;
}

/* --- Bottom panel (save bar) --- */
.AknDefault-bottomPanel {
  background: white !important;
  border-top: 1px solid #D9DDE2 !important;
  display: flex !important;
  align-items: center !important;
  padding: 0 20px 0 10px !important;
  flex-basis: 70px !important;
  min-height: 70px !important;
  flex-shrink: 0 !important;
}

.AknDefault-bottomPanel--hidden {
  flex-basis: 0 !important;
  min-height: 0 !important;
  overflow: hidden !important;
}

/* --- Title container / breadcrumbs --- */
.AknTitleContainer {
  display: flex !important;
  align-items: center !important;
  padding: 15px 40px !important;
  background: white !important;
  min-height: 64px !important;
  flex-shrink: 0 !important;
  border-bottom: 1px solid #D9DDE2 !important;
}

/* --- Loading state fix --- */
.AknDefault-progressContainer {
  width: 940px !important;
  font-size: 28px !important;
  display: block !important;
  margin: 200px auto 0 !important;
  text-align: center !important;
  line-height: 40px !important;
}

/* --- Third column (panel slide-out) --- */
.AknDefault-thirdColumnContainer {
  order: -5 !important;
  margin-left: -300px !important;
  position: relative !important;
  transition: margin 0.3s ease-in-out !important;
}

.AknDefault-thirdColumnContainer--open {
  margin-left: 0 !important;
}

.AknDefault-thirdColumn {
  height: 100vh !important;
  background: white !important;
  z-index: 801 !important;
  border-right: 1px solid #ccd1d8 !important;
  padding: 20px !important;
  width: 300px !important;
}

/* --- Grid / datagrid layout --- */
.AknGrid {
  width: 100% !important;
}

.AknGrid .AknGrid-bodyContainer {
  overflow-y: auto !important;
  flex-grow: 1 !important;
}

/* --- Filter box layout --- */
.AknFilterBox {
  display: flex !important;
  align-items: center !important;
  padding: 10px 20px !important;
  background: white !important;
  border-bottom: 1px solid #D9DDE2 !important;
  flex-shrink: 0 !important;
  flex-wrap: wrap !important;
  gap: 5px !important;
}

/* --- Vertical scroll container used in product grid --- */
.AknDefault-verticalScrollContainer {
  display: flex !important;
  flex-grow: 1 !important;
  overflow: hidden !important;
}

/* --- Tab bar styling fix --- */
.AknTabContainer {
  border-bottom: 1px solid #D9DDE2 !important;
  display: flex !important;
  flex-shrink: 0 !important;
}

/* --- Modal / overlay z-index fixes --- */
.AknFullPage {
  z-index: 1040 !important;
}

.hash-loading-mask {
  display: none !important;
}

/* --- Scrollbar styling --- */
.AknDefault-mainContent::-webkit-scrollbar,
.AknColumn-inner::-webkit-scrollbar {
  width: 6px;
}

.AknDefault-mainContent::-webkit-scrollbar-track,
.AknColumn-inner::-webkit-scrollbar-track {
  background: transparent;
}

.AknDefault-mainContent::-webkit-scrollbar-thumb,
.AknColumn-inner::-webkit-scrollbar-thumb {
  background: #ccd1d8;
  border-radius: 3px;
}

.AknDefault-mainContent::-webkit-scrollbar-thumb:hover,
.AknColumn-inner::-webkit-scrollbar-thumb:hover {
  background: #9aa3b0;
}

/* --- Fix for hash loading mask that can block the entire page --- */
.hash-loading-mask.hash-loading-mask--full-page {
  position: fixed !important;
  z-index: 9999 !important;
}

/* --- Ensure view containers take full height --- */
.view {
  height: 100% !important;
  display: flex !important;
  flex-direction: column !important;
}

/* --- Sub-navigation / secondary menu --- */
.AknSubNav {
  background: white !important;
  border-bottom: 1px solid #D9DDE2 !important;
  padding: 0 40px !important;
  display: flex !important;
  align-items: center !important;
  min-height: 44px !important;
  flex-shrink: 0 !important;
}
